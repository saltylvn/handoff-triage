# Names only. Set real values with: sh scripts/set-secret.sh NAME (saved to the git-ignored .env.local)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# openssl rand -hex 32
WEBHOOK_SECRET=
# openssl rand -base64 32  (encrypts stored OAuth tokens)
TOKEN_ENCRYPTION_KEY=
PUBLIC_BASE_URL=http://localhost:3000
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=
# Comma-separated Slack user IDs allowed to approve. Empty means nobody can.
SLACK_APPROVER_IDS=
CONFIDENCE_THRESHOLD=0.8
DATABASE_PATH=./triage.sqlite
