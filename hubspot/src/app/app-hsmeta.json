{
  "uid": "inbound_triage_agent_app",
  "type": "app",
  "config": {
    "description": "Triages contact form messages and updates contacts, with human approval for risky cases. Portfolio project using synthetic data.",
    "name": "Handoff Triage",
    "distribution": "private",
    "auth": {
      "type": "oauth",
      "redirectUrls": [
        "http://localhost:3000/oauth/hubspot/callback"
      ],
      "requiredScopes": [
        "oauth",
        "crm.objects.contacts.read",
        "crm.objects.contacts.write"
      ],
      "optionalScopes": [],
      "conditionallyRequiredScopes": []
    },
    "permittedUrls": {
      "fetch": [
        "https://api.hubapi.com"
      ],
      "iframe": [],
      "img": []
    }
  }
}
